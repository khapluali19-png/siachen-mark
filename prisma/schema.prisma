generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  password       String?
  role           Role            @default(EDITOR)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  passwordResets PasswordReset[]
  sessions       Session[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model HeroContent {
  id               String   @id @default(cuid())
  headline         String
  subline          String
  ctaPrimary       String
  ctaSecondary     String
  updatedAt        DateTime @updatedAt
  badge            String?
  ctaPrimaryHref   String?
  ctaSecondaryHref String?
  stats            Json?
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  icon        String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([order])
}

model PortfolioProject {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  services    String[]
  description String
  result      String?
  coverImage  String?
  images      String[]
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  role      String
  company   String?
  industry  String?
  avatar    String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  image     String?
  linkedin  String?
  isFounder Boolean  @default(false)
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stats     Json?
  title     String?
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  seo         SeoMeta?

  @@index([slug])
  @@index([publishedAt])
}

model Career {
  id           String              @id @default(cuid())
  title        String
  department   String
  type         String
  location     String
  description  String
  requirements String
  published    Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  applications CareerApplication[]
}

model ContactSubmission {
  id         String     @id @default(cuid())
  name       String
  email      String
  phone      String?
  industry   String?
  service    String?
  message    String
  ip         String?
  userAgent  String?
  read       Boolean    @default(false)
  createdAt  DateTime   @default(now())
  budget     String?
  company    String?
  notes      String?
  sourcePage String?
  status     LeadStatus @default(NEW)

  @@index([createdAt])
  @@index([read])
  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
}

model CareerApplication {
  id        String   @id @default(cuid())
  careerId  String
  name      String
  email     String
  phone     String?
  message   String?
  resumeUrl String?
  ip        String?
  createdAt DateTime @default(now())
  career    Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@index([careerId])
  @@index([createdAt])
}

model MediaFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  key       String   @unique
  size      Int
  type      String
  folder    String?
  createdAt DateTime @default(now())

  @@index([folder])
  @@index([type])
}

model SeoMeta {
  id          String    @id @default(cuid())
  page        String?   @unique
  blogPostId  String?   @unique
  title       String?
  description String?
  ogTitle     String?
  ogDesc      String?
  ogImage     String?
  twitterCard String?
  canonical   String?
  robots      String?
  schema      String?
  updatedAt   DateTime  @updatedAt
  blogPost    BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

enum Role {
  ADMIN
  EDITOR
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CLOSED
}
